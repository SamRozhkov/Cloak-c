# Named so the `gobuild` stage below can be built ON TOP of the finished
# development image rather than beside it: it needs this stage's Go
# toolchain and its curl, and nothing else. The name is the only change to
# this stage -- every layer below it is byte-identical to what module 8
# left, and the final stage inherits its ENV and its WORKDIR.
FROM debian:bookworm-slim AS base

# clang and libclang-rt are here for ONE reason: libFuzzer. It is a
# clang/compiler-rt feature with no GCC equivalent -- this image's gcc
# (Debian 12.2.0-14+deb12u1) answers `-fsanitize=fuzzer` with
# "unrecognized argument to '-fsanitize=' option: 'fuzzer'", measured in
# this image before these packages were added.
#
# BOTH packages are required, and this comment exists so nobody trims the
# second one: Debian ships the compiler-rt runtime archives in a separate
# package from the compiler, so `clang` ALONE compiles a fuzz target and
# then fails at link with
#   cannot find .../lib/linux/libclang_rt.fuzzer-aarch64.a
# (that link failure was reported by a scout's clang-only build and is
# recorded here as READ, not re-measured -- what WAS measured here is that
# libclang_rt.fuzzer-aarch64.a is present in the built image and that a
# `-fsanitize=fuzzer,address` target links and runs; see below).
# libclang-rt-14-dev is that file. Measured cost, comparing `docker images`
# before and after on arm64: 1.01 GB -> 1.36 GB, i.e. +350 MB. That is
# MORE than the +264 MB a scout estimated, because apt pulls clang-14,
# libclang-cpp14 (53 MB installed) and llvm-14-linker-tools in as well;
# 1.36 GB is the number this build actually produced, not an estimate.
#
# VERIFIED, not assumed: a throwaway libFuzzer target with a deliberate
# null dereference behind a "FUZZZZ" prefix, built in this image with
# `clang -fsanitize=fuzzer,address`, was found and minimised by libFuzzer
# in under a second -- `SUMMARY: AddressSanitizer: SEGV`, crashing unit
# `FUZZZZ`, `Base64: RlVaWlpa`. A toolchain that merely links is not a
# working fuzzer, and on this codebase a green fuzz run is the expected
# result, so a planted bug is the only evidence the instrument is wired up.
#
# gcc stays the project's default compiler and CI still builds with it;
# clang is an ADDITIONAL compiler here, which is why the tree is required
# to be warning-free under both -- measured at this commit: full Debug
# builds of libraries, binaries and all 75 test executables produce ZERO
# warnings under gcc 12.2.0 and zero under clang 14.0.6, and `ctest` is
# 75/75 under each.

# AND llvm-14, FOR ONE FILE: /usr/lib/llvm-14/bin/llvm-symbolizer. Without
# it every sanitizer report in this image is a list of raw addresses --
# `SUMMARY: AddressSanitizer: SEGV (/w/probe+0x10b808)` and nothing else --
# which is the difference between a fuzz finding you can act on and one you
# cannot.
#
# TASK 0 REPORTED THIS FILE WAS ALREADY IN THE IMAGE, AT
# /usr/lib/llvm-14/bin/, NEEDING ONLY A PATH ENTRY. IT WAS NOT, AND THIS
# COMMENT EXISTS SO THAT CLAIM IS NOT ACTED ON AGAIN: measured in the image
# BEFORE this line was added, `find / -name "llvm-symbolizer*"` returned
# NOTHING, and /usr/lib/llvm-14/bin contained exactly four files (clang,
# clang++, clang-14, clang-cpp). A PATH entry alone would have left every
# crash unsymbolized while looking like a fix.
#
# llvm-14 AND NOT SOMETHING SMALLER, measured not guessed: llvm-14-runtime
# (1.4 MB installed) ships only lli and lli-child-target -- `dpkg -L` after
# installing it found no llvm-symbolizer -- and llvm-14-tools ships neither.
# llvm-14 is the package that has it. Measured cost in this image, where
# libllvm14 and llvm-14-linker-tools are already present as clang's
# dependencies: 8 new packages (libnspr4, libsqlite3-0, libnss3,
# nss-plugin-pem, libcurl3-nss, libpfm4, llvm-14-runtime, llvm-14),
# "Need to get 13.0 MB of archives", "After this operation, 55.0 MB of
# additional disk space will be used".
#
# WHY NOT addr2line, WHICH IS ALREADY HERE AND COSTS ZERO. It was tried,
# and it is the trap, not the bargain. compiler-rt accepts any
# ASAN_SYMBOLIZER_PATH and falls back to an addr2line pool for a binary
# whose name is not llvm-symbolizer, so `ASAN_SYMBOLIZER_PATH=
# /usr/bin/addr2line` DOES produce file:line output and DOES look like it
# works. On the same planted crash (a null read in a `static` helper the
# compiler inlined into its one caller) the two disagree:
#
#   addr2line:        #0 ... in LLVMFuzzerTestOneInput /w/probe.c:6
#   llvm-symbolizer:  #0 ... in boom /w/probe.c:6:24
#                     #1 ... in LLVMFuzzerTestOneInput /w/probe.c:12:16
#
# addr2line DROPPED the inlined frame and then attributed the callee's line
# number to the caller's name -- a report naming the wrong function. This
# tree is full of `static` helpers that inline (heap_push, heap_pop,
# try_drain, ring_put, ring_peek in libcloak-mux alone), so that is the
# normal case here, not the corner case. 55 MB buys frames that name the
# function the bug is actually in.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    libclang-rt-14-dev \
    llvm-14 \
    cmake \
    libssl-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# The symbolizer, wired up where every sanitizer run in this image sees it
# rather than in each fuzz invocation's own command line -- ASan, LSan,
# UBSan and libFuzzer all read this one variable. The versioned real path,
# not /usr/bin/llvm-symbolizer-14, which is only a symlink to it.
#
# VERIFIED, not assumed, at the commit that added it. A one-character
# off-by-one planted in libcloak-mux/src/msgqueue.c (a dropped
# `% q->cap`) was found by fuzz/fuzz_session_envelope.c and reported as:
#
#   #1 ... in ring_put .../libcloak-mux/src/msgqueue.c:25:9
#   #2 ... in cloak_msgqueue_write .../libcloak-mux/src/msgqueue.c:76:9
#   #3 ... in feed_frame_unordered .../libcloak-mux/src/stream.c:354:14
#   #5 ... in session_on_envelope .../libcloak-mux/src/session.c:320:18
#
# Function, file, line and column -- including `ring_put`, which is
# `static` and inlined, and `session_on_envelope`, which is `static` and
# is the code under test. An unproven symbolizer is indistinguishable
# from a missing one until the day you need it.
ENV ASAN_SYMBOLIZER_PATH=/usr/lib/llvm-14/bin/llvm-symbolizer

# A Go toolchain, for one reason: module 8's tests need an implementation
# nobody here wrote. Every test in the first seven modules had our code on
# both ends, which is exactly how this port shipped a framing defect that
# survived five modules -- a round-trip test cannot see a self-consistent
# error. gorilla/websocket is a fussy, independently written RFC 6455
# validator, and Go's own client is the reference this port is a port of.
#
# Debian bookworm's golang-go is 1.19, older than gorilla v1.5.3's floor,
# so the official tarball is used instead. The module is pre-downloaded
# into the image's module cache so the test build needs no network.
ARG GO_VERSION=1.25.6
ARG GORILLA_VERSION=v1.5.3
RUN arch="$(dpkg --print-architecture)" \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" \
       -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz
ENV PATH=/usr/local/go/bin:$PATH
ENV GOPATH=/go GOMODCACHE=/go/pkg/mod GOFLAGS=-mod=mod
RUN mkdir -p /go/src/oracle && cd /go/src/oracle \
    && go mod init oracle >/dev/null \
    && go get "github.com/gorilla/websocket@${GORILLA_VERSION}" \
    && go mod download all

WORKDIR /src

# ---------------------------------------------------------------------------
# Go Cloak's OWN ck-client and ck-server binaries, for module 9 task 1's
# test_go_interop.
#
# WHY BINARIES AND NOT MORE GO SOURCE. The oracle above (gorilla/websocket)
# is a library this build compiles a small Go program against, and it only
# ever tested the server's WEBSOCKET leg. The DIRECT (TLS-shaped) leg and
# the whole C CLIENT had never been run against foreign code at all -- both
# ends of every one of their tests were ours, which is the exact condition
# under which this port once shipped a frame format no Go peer could read.
# The cheapest way to fix that is not to reimplement Cloak's client in Go,
# it is to run Cloak's client.
#
# WHY A TARBALL AND NOT `go install`. `go install github.com/cbeuw/Cloak/
# cmd/ck-client@v2.12.0` DOES NOT WORK, and this comment exists so nobody
# tries it again: Cloak's go.mod declares `module github.com/cbeuw/Cloak`
# with no /v2 suffix, so its v2.x tags are +incompatible and are not served
# by proxy.golang.org (https://proxy.golang.org/github.com/cbeuw/!cloak/@v/
# list returns only v0.x and v1.x). Go then falls back to direct VCS and
# dies with `exec: "git": executable file not found in $PATH`. Installing
# git and cloning instead works but costs +450 MB in a single stage;
# fetching the release tarball with the curl already installed above costs
# +30 MB, because only the two binaries are copied out.
#
# v2.12.0 is pinned, not a branch: it is commit c3d5470ef76bba68d7812f5d06e
# 4181dc1b1a5d6, the revision this port was read against.
#
# The binaries are built WITHOUT upstream's `-ldflags -X main.version=`, so
# `go-ck-client -v` prints an empty version. Harmless, and nothing asserts
# on it.
FROM base AS gobuild
ARG CLOAK_UPSTREAM=v2.12.0
RUN mkdir -p /tmp/up \
    && curl -fsSL "https://github.com/cbeuw/Cloak/archive/refs/tags/${CLOAK_UPSTREAM}.tar.gz" \
       | tar -xz -C /tmp/up --strip-components=1 \
    && cd /tmp/up \
    && go build -o /out/go-ck-client ./cmd/ck-client \
    && go build -o /out/go-ck-server ./cmd/ck-server

# The image the project is actually built and tested in: `base`, plus two
# binaries. Everything the gobuild stage downloaded to produce them -- the
# source tree, Cloak's own ~10 modules, Go's build cache -- stays in that
# stage and never reaches here.
FROM base
COPY --from=gobuild /out/go-ck-client /out/go-ck-server /usr/local/bin/
